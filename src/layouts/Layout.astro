---
const { title = "" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-page-title={title}>{title || 'Profile'}</title>
    <meta name="description" content="AT Protocol profile" />
    <meta property="og:title" content={title || 'Profile'} />
    <meta property="og:description" content="AT Protocol profile" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    />
    <style is:global>
      /* Hide MathML but keep it for screen readers */
      .katex-mathml {
        position: absolute;
        clip: rect(1px, 1px, 1px, 1px);
        padding: 0;
        border: 0;
        height: 1px;
        width: 1px;
        overflow: hidden;
      }

      /* Ensure display math ($$) is always a centered block */
      .katex-display {
        display: block !important;
        text-align: center !important;
        margin: 2em 0 !important;
        width: 100% !important;
        overflow-x: auto;
        overflow-y: hidden;
      }

      /* Fix for potential flexbox/grid containers */
      .katex-display > .katex {
        display: inline-block !important;
        text-align: center !important;
        white-space: nowrap;
        margin: 0 auto !important;
      }

      /* Remove any list-style or bullet points if it's inside a list by accident */
      .notion-list .katex-display,
      .content .katex-display {
        list-style: none !important;
      }
    </style>
  </head>
  <body>
    <div class="layout-wrapper">
      <button
        class="menu-toggle"
        type="button"
        aria-controls="site-navigation"
        aria-expanded="false"
        aria-label="メニューを開く"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <!-- ▼ 左側の固定サイドバー -->
      <aside class="sidebar" id="site-navigation">
        <nav class="nav-menu" aria-label="メインナビゲーション">
          <a href="/">ホーム</a>
          <a href="/#publications">論文</a>
          <a href="/#contact">連絡先</a>
          <a href="/blog">ブログ</a>
        </nav>
      </aside>
      <button class="menu-backdrop" type="button" aria-label="メニューを閉じる" tabindex="-1"></button>

      <!-- ▼ 右側のメインコンテンツ + フッター -->
      <div class="main-container">
        <main class="content">
          <slot />
        </main>

        <footer class="footer" id="contact">
          <div class="footer-content">
            <p class="footer-title">Contact</p>
            <p class="footer-email">
              <span class="icon">✉</span> fukushima.takeru.u8 [at] s.mail.nagoya-u.ac.jp
            </p>
          </div>
        </footer>
      </div>

    </div>
    <script is:inline>
      const menuToggle = document.querySelector('.menu-toggle');
      const sidebar = document.querySelector('.sidebar');
      const menuBackdrop = document.querySelector('.menu-backdrop');
      const mainContainer = document.querySelector('.main-container');
      const mobileMenu = window.matchMedia('(max-width: 768px)');

      function setMenu(open, restoreFocus = false) {
        const shouldOpen = mobileMenu.matches && open;
        const english = document.documentElement.lang === 'en';
        document.body.classList.toggle('menu-open', shouldOpen);
        menuToggle.setAttribute('aria-expanded', String(shouldOpen));
        menuToggle.setAttribute('aria-label', shouldOpen
          ? (english ? 'Close menu' : 'メニューを閉じる')
          : (english ? 'Open menu' : 'メニューを開く'));
        sidebar.inert = mobileMenu.matches && !shouldOpen;
        mainContainer.inert = shouldOpen;
        menuBackdrop.tabIndex = shouldOpen ? 0 : -1;

        if (shouldOpen) sidebar.querySelector('a')?.focus();
        if (!shouldOpen && restoreFocus) menuToggle.focus();
      }

      menuToggle.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        setMenu(!isOpen, isOpen);
      });
      menuBackdrop.addEventListener('click', () => setMenu(false, true));
      sidebar.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
          setMenu(false, true);
        }
      });
      mobileMenu.addEventListener('change', () => setMenu(false));
      setMenu(false);

      (async function syncProfileMetadata() {
        const did = 'did:plc:nmhfq335cddnwt4ovrq4gzsm';
        const fallbackPds = 'https://chaga.us-west.host.bsky.network';
        try {
          let pds = fallbackPds;
          try {
            const didResponse = await fetch(`https://plc.directory/${did}`);
            if (didResponse.ok) {
              const didDocument = await didResponse.json();
              pds = didDocument.service?.find((service) =>
                service.id === '#atproto_pds' || service.type === 'AtprotoPersonalDataServer'
              )?.serviceEndpoint || fallbackPds;
            }
          } catch { /* fallback PDSを使う */ }

          const query = new URLSearchParams({
            repo: did,
            collection: 'id.career.profile',
            rkey: 'self'
          });
          const response = await fetch(`${pds}/xrpc/com.atproto.repo.getRecord?${query}`);
          if (!response.ok) throw new Error(`profile: ${response.status}`);
          const { value: profile } = await response.json();
          const locale = document.documentElement.lang === 'en' ? 'en' : 'ja';
          const localizedText = (value) => {
            if (typeof value === 'string' || typeof value === 'number') return String(value);
            if (!Array.isArray(value)) return '';
            const variants = value.filter((item) =>
              item && typeof item.language === 'string' && typeof item.value === 'string'
            );
            return variants.find((item) => item.language === locale)?.value
              || variants.find((item) => item.language === 'en')?.value
              || variants[0]?.value
              || '';
          };
          const displayName = localizedText(profile.displayName)
            || localizedText(profile.nativeName);
          const titleElement = document.querySelector('title');
          const pageTitle = titleElement?.dataset.pageTitle || '';
          if (displayName) {
            document.title = pageTitle ? `${pageTitle} | ${displayName}` : displayName;
            document.querySelector('meta[property="og:title"]')?.setAttribute('content', document.title);
          }
          const description = document.querySelector('meta[name="description"]');
          if (profile.bio) {
            description?.setAttribute('content', profile.bio);
            document.querySelector('meta[property="og:description"]')?.setAttribute('content', profile.bio);
          }
        } catch (error) {
          console.error('Could not sync AT Protocol profile metadata.', error);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  /* 全体の基本設定 */
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    /* Hoefler Text や明朝体を使用し、アカデミックな雰囲気に */
    font-family: "Hoefler Text", "Baskerville", "Times New Roman", "Hiragino Mincho ProN", "Yu Mincho", serif;
    color: #1a1a1a;
    line-height: 1.7;
    background-color: #fff;
  }

  /* MDXコンテンツ用のグローバルスタイル */
  .content h1 {
    font-size: 28px;
    margin-bottom: 40px;
    font-weight: bold;
    color: #1a1a1a;
    letter-spacing: -0.01em;
  }
  
  .content h2 {
    font-size: 22px;
    margin-top: 50px;
    margin-bottom: 24px;
    font-weight: bold;
  }

  .content p {
    margin-bottom: 1.5em;
    font-size: 15px;
  }

  .content a {
    color: #3b82f6;
    text-decoration: none;
    border-bottom: 1px solid #dae7ff;
  }

  .content a:hover {
    border-bottom-color: #3b82f6;
  }

  .content ol {
    padding-left: 24px;
    margin-top: 20px;
  }

  .content li {
    margin-bottom: 20px;
    font-size: 15px;
  }
</style>

<style>
  .layout-wrapper {
    display: flex;
    min-height: 100vh;
  }

  .menu-toggle,
  .menu-backdrop {
    display: none;
  }

  /* 左メニュー（薄いベージュ背景で固定） */
  .sidebar {
    width: 240px;
    background-color: #f9f9f7;
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .nav-menu {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 15px;
    text-align: center;
  }

  .nav-menu a {
    text-decoration: none;
    color: #555;
    transition: color 0.2s;
    letter-spacing: 0.1em;
    position: relative;
    padding: 4px 0;
  }

  /* 中央から広がる下線のアニメーション */
  .nav-menu a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: #000;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .nav-menu a:hover {
    color: #000;
  }

  .nav-menu a:hover::after {
    transform: scaleX(1);
  }

  /* 右側のコンテナ */
  .main-container {
    margin-left: 240px;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #fff;
  }

  /* コンテンツエリア */
  .content {
    padding: 80px 100px 100px 80px;
    flex: 1;
    width: 100%;
    max-width: 1000px;
  }

  /* フッター（ダーク背景） */
  .footer {
    background-color: #1a1c23;
    color: #fff;
    padding: 80px 80px;
    width: 100%;
  }

  .footer-content {
    max-width: 800px;
  }

  .footer-title {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 24px;
    letter-spacing: 0.05em;
  }

  .footer-email {
    font-size: 14px;
    margin: 0;
    color: #aaa;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer .icon {
    font-size: 14px;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    :global(body.menu-open) {
      overflow: hidden;
    }

    .layout-wrapper {
      flex-direction: column;
    }

    .menu-toggle {
      position: fixed;
      top: 16px;
      left: 16px;
      z-index: 300;
      display: flex;
      width: 44px;
      height: 44px;
      padding: 0 11px;
      border: 1px solid rgba(26, 26, 26, 0.12);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 4px 18px rgba(26, 26, 26, 0.1);
      cursor: pointer;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
    }

    .menu-toggle span {
      display: block;
      width: 100%;
      height: 1px;
      background: #1a1a1a;
      transition: transform 0.25s ease, opacity 0.2s ease;
    }

    .menu-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(6px) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-6px) rotate(-45deg);
    }

    .menu-toggle:focus-visible,
    .nav-menu a:focus-visible {
      outline: 2px solid #326b9f;
      outline-offset: 4px;
    }

    .sidebar {
      z-index: 250;
      width: min(280px, 82vw);
      height: 100dvh;
      padding: 96px 48px 48px;
      align-items: flex-start;
      justify-content: flex-start;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }

    :global(body.menu-open) .sidebar {
      transform: translateX(0);
    }

    .nav-menu {
      gap: 26px;
      text-align: left;
    }

    .menu-backdrop {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: block;
      border: 0;
      background: rgba(20, 20, 18, 0.38);
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    :global(body.menu-open) .menu-backdrop {
      opacity: 1;
      visibility: visible;
    }

    .main-container {
      margin-left: 0;
      width: 100%;
    }

    .content {
      padding: 84px 20px 60px;
    }

    .footer {
      padding: 60px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle span,
    .sidebar,
    .menu-backdrop {
      transition: none;
    }
  }
</style>
