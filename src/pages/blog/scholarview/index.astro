---
// MAGI
// ScholarView のレコード群をブラウザから直接 PDS 取得して表示する。
// GitHub Pages の静的配信のまま、ScholarView 側の追加・更新を開くたびに反映する。
import Layout from '../../../layouts/Layout.astro';
// /MAGI
---

<Layout title="ScholarView / AT Protocol">
  <!-- MAGI -->
  <div class="scholar-app">
    <header class="scholar-head">
      <a href="/blog" class="back-link">← Blog</a>
      <h1>ScholarView</h1>
      <p>AT Protocol上の研究記事をPDSから直接取得（ライブ同期）</p>
    </header>

    <div id="scholar-content" aria-live="polite">
      <p class="scholar-status">読み込み中… / Loading…</p>
    </div>
  </div>

  <script>
    import katex from 'katex';
    import 'katex/dist/katex.min.css';

    // MAGI
    (function () {
      const DID = "did:plc:nmhfq335cddnwt4ovrq4gzsm";
      const FALLBACK_PDS = "https://chaga.us-west.host.bsky.network";
      const COLLECTIONS = {
        articles: "sci.peer.article",
        notes: "sci.peer.encNote",
        vaults: "sci.peer.encVault",
        projects: "sci.peer.workspaceProject",
        collections: "pub.paper.collection",
        items: "pub.paper.collectionItem",
        references: "pub.paper.reference",
      };

      const content = document.getElementById("scholar-content");
      const esc = (value) =>
        String(value == null ? "" : value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      const rkeyOf = (uri) => String(uri || "").split("/").pop();
      const formatDate = (iso) => {
        const date = new Date(iso || "");
        return Number.isNaN(date.valueOf()) ? "" : date.toISOString().slice(0, 10);
      };

      let state = null;

      async function resolvePds() {
        try {
          const response = await fetch("https://plc.directory/" + DID);
          if (!response.ok) throw new Error("plc " + response.status);
          const document = await response.json();
          const service = (document.service || []).find(
            (entry) =>
              entry.id === "#atproto_pds" ||
              entry.type === "AtprotoPersonalDataServer"
          );
          if (service && service.serviceEndpoint) return service.serviceEndpoint;
        } catch (_) {
          // DID 解決に失敗した場合のみ既知の PDS を使う。
        }
        return FALLBACK_PDS;
      }

      async function listRecords(pds, collection) {
        const records = [];
        let cursor = "";
        do {
          const params = new URLSearchParams({
            repo: DID,
            collection,
            limit: "100",
          });
          if (cursor) params.set("cursor", cursor);
          const response = await fetch(
            pds + "/xrpc/com.atproto.repo.listRecords?" + params
          );
          if (!response.ok) throw new Error(collection + " " + response.status);
          const data = await response.json();
          records.push(...(data.records || []));
          cursor = data.cursor || "";
        } while (cursor);
        return records;
      }

      function blobUrl(image) {
        const cid = image?.blob?.ref?.["$link"];
        if (!cid || !state?.pds) return "";
        const params = new URLSearchParams({ did: DID, cid });
        return state.pds + "/xrpc/com.atproto.sync.getBlob?" + params;
      }

      function renderMath(source, displayMode) {
        try {
          return katex.renderToString(source, {
            displayMode,
            throwOnError: false,
            strict: "warn",
          });
        } catch (_) {
          return '<code class="math-error">' + esc(source) + "</code>";
        }
      }

      function citationContext(value) {
        const byKey = new Map(
          (value.bibliography || []).map((entry) => [entry.key, entry])
        );
        const order = [];
        for (const block of value.blocks || []) {
          const text = String(block.content || "");
          for (const match of text.matchAll(/\\cite\{([^}]+)\}/g)) {
            for (const key of match[1].split(",").map((item) => item.trim()).filter(Boolean)) {
              if (!order.includes(key)) order.push(key);
            }
          }
        }
        return { byKey, order };
      }

      function renderInline(text, value, citations) {
        const images = new Map((value.images || []).map((image) => [image.path, image]));
        const pattern = /!\[([^\]]*)\]\(([^)]+)\)(?:\{[^}]*\})?|\\cite\{([^}]+)\}|\$([^$\n]+)\$|https?:\/\/[^\s<>]+/g;
        let html = "";
        let cursor = 0;
        for (const match of String(text || "").matchAll(pattern)) {
          html += esc(text.slice(cursor, match.index));
          if (match[1] != null) {
            const image = images.get(match[2]);
            const src = image ? blobUrl(image) : match[2];
            html += src
              ? '<figure><img src="' + esc(src) + '" alt="' + esc(match[1] || image?.alt || "") + '" loading="lazy"><figcaption>' + esc(match[1] || image?.alt || "") + "</figcaption></figure>"
              : esc(match[0]);
          } else if (match[3] != null) {
            const keys = match[3].split(",").map((item) => item.trim()).filter(Boolean);
            html += '<span class="citation">' + keys.map((key) => {
              const number = citations.order.indexOf(key) + 1;
              return number
                ? '<a href="#ref-' + encodeURIComponent(key) + '">[' + number + "]</a>"
                : "[?]";
            }).join("") + "</span>";
          } else if (match[4] != null) {
            html += renderMath(match[4], false);
          } else {
            html += '<a href="' + esc(match[0]) + '" target="_blank" rel="noopener">' + esc(match[0]) + "</a>";
          }
          cursor = match.index + match[0].length;
        }
        return html + esc(String(text || "").slice(cursor));
      }

      function renderMarkdownish(text, value, citations) {
        return String(text || "")
          .trim()
          .split(/\n{2,}/)
          .map((part) => {
            const displayMath = part.match(/^\s*(?:\$\$([\s\S]+)\$\$|\\\[([\s\S]+)\\\])\s*$/);
            if (displayMath) {
              return '<div class="math-display">' + renderMath(displayMath[1] || displayMath[2], true) + "</div>";
            }
            const lines = part.split("\n");
            if (lines.every((line) => /^\s*[-*]\s+/.test(line))) {
              return (
                "<ul>" +
                lines
                  .map((line) => "<li>" + renderInline(line.replace(/^\s*[-*]\s+/, ""), value, citations) + "</li>")
                  .join("") +
                "</ul>"
              );
            }
            return "<p>" + lines.map((line) => renderInline(line, value, citations)).join("<br>") + "</p>";
          })
          .join("");
      }

      function projectFor(articleUri) {
        return state.projects.find((record) =>
          (record.value.nodes || []).some(
            (node) => node.linkedArticleUri === articleUri
          )
        );
      }

      function collectionFor(project) {
        if (!project || !project.value.collectionUri) return null;
        return state.collections.find(
          (record) => record.uri === project.value.collectionUri
        );
      }

      function referencesFor(collection) {
        if (!collection) return [];
        const referenceUris = new Set(
          state.items
            .filter((record) => record.value.collection?.uri === collection.uri)
            .map((record) => record.value.reference?.uri)
        );
        return state.references.filter((record) => referenceUris.has(record.uri));
      }

      function referenceLabel(record) {
        const value = record.value || {};
        const authors = Array.isArray(value.authors)
          ? value.authors
              .map((author) =>
                typeof author === "string" ? author : author.name || author.family || ""
              )
              .filter(Boolean)
              .join(", ")
          : "";
        return [authors, value.year, value.title].filter(Boolean).join(". ") || "(書誌情報なし)";
      }

      function renderList() {
        if (!state.articles.length) {
          content.innerHTML = '<p class="scholar-status">公開記事はまだありません。</p>';
          return;
        }
        content.innerHTML =
          '<ul class="scholar-list">' +
          state.articles
            .map((record) => {
              const value = record.value || {};
              const project = projectFor(record.uri);
              return (
                "<li>" +
                '<a class="scholar-item-title" href="#/' +
                encodeURIComponent(rkeyOf(record.uri)) +
                '">' +
                esc(value.title || "(無題)") +
                "</a>" +
                '<div class="scholar-meta">' +
                (formatDate(value.createdAt)
                  ? "<time>" + esc(formatDate(value.createdAt)) + "</time>"
                  : "") +
                (project
                  ? '<span class="scholar-project">' + esc(project.value.path || "") + "</span>"
                  : "") +
                "</div></li>"
              );
            })
            .join("") +
          "</ul>" +
          '<p class="sync-note">' +
          state.articles.length +
          " articles / " +
          state.projects.length +
          " projects / " +
          state.references.length +
          " references を同期中</p>";
      }

      function renderDetail(rkey) {
        const record = state.articles.find((item) => rkeyOf(item.uri) === rkey);
        if (!record) {
          content.innerHTML =
            '<p class="scholar-status">記事が見つかりません。<a href="#/">一覧へ戻る</a></p>';
          return;
        }

        const value = record.value || {};
        const project = projectFor(record.uri);
        const collection = collectionFor(project);
        const references = referencesFor(collection);
        const citations = citationContext(value);
        const authors = (value.authors || [])
          .map((author) => author.name || author.did || "")
          .filter(Boolean);
        const blocks = (value.blocks || [])
          .map((block) => {
            const level = Math.min(Math.max(Number(block.level) || 2, 2), 6);
            return (
              (block.heading
                ? "<h" + level + ">" + esc(block.heading) + "</h" + level + ">"
                : "") + renderMarkdownish(block.content, value, citations)
            );
          })
          .join("");

        let bibliography = "";
        if (citations.order.length) {
          bibliography =
            '<section class="scholar-bibliography"><h2>References</h2><ol>' +
            citations.order.map((key) => {
              const entry = citations.byKey.get(key);
              return '<li id="ref-' + encodeURIComponent(key) + '"><code>' + esc(key) + "</code>" +
                (entry?.rawBibtex ? '<pre>' + esc(entry.rawBibtex) + "</pre>" : "") + "</li>";
            }).join("") + "</ol></section>";
        } else if (references.length) {
          bibliography =
            '<section class="scholar-bibliography"><h2>Project references</h2><ol>' +
            references
              .map((reference) => "<li>" + esc(referenceLabel(reference)) + "</li>")
              .join("") +
            "</ol></section>";
        } else if ((value.bibliography || []).length) {
          bibliography =
            '<section class="scholar-bibliography"><h2>Bibliography</h2><ul>' +
            value.bibliography
              .map((entry) => "<li><code>" + esc(entry.key || "reference") + "</code></li>")
              .join("") +
            "</ul></section>";
        }

        const sourceUrl =
          "https://pdsls.dev/" + encodeURI(record.uri).replace(/%3A/g, ":");
        content.innerHTML =
          '<article class="scholar-article">' +
          '<a class="back-link" href="#/">← 一覧 / Index</a>' +
          "<h1>" + esc(value.title || "(無題)") + "</h1>" +
          '<div class="scholar-meta">' +
          (authors.length ? "<span>" + esc(authors.join(", ")) + "</span>" : "") +
          (formatDate(value.createdAt) ? "<time>" + esc(formatDate(value.createdAt)) + "</time>" : "") +
          (project ? '<span class="scholar-project">' + esc(project.value.path || "") + "</span>" : "") +
          "</div>" +
          '<div class="scholar-body">' + blocks + "</div>" +
          bibliography +
          '<p class="scholar-source"><a href="' +
          esc(sourceUrl) +
          '" target="_blank" rel="noopener">PDS recordを開く ↗</a></p>' +
          "</article>";
        window.scrollTo(0, 0);
      }

      function route() {
        const hash = location.hash.replace(/^#\/?/, "");
        if (hash) renderDetail(decodeURIComponent(hash));
        else renderList();
      }

      async function init() {
        try {
          const pds = await resolvePds();
          const keys = Object.keys(COLLECTIONS);
          const results = await Promise.all(
            keys.map((key) => listRecords(pds, COLLECTIONS[key]).catch(() => []))
          );
          state = Object.fromEntries(keys.map((key, index) => [key, results[index]]));
          state.pds = pds;
          state.articles.sort((a, b) =>
            String(b.value.createdAt || "").localeCompare(String(a.value.createdAt || ""))
          );
          window.addEventListener("hashchange", route);
          route();
        } catch (error) {
          content.innerHTML =
            '<p class="scholar-status">取得に失敗しました: ' +
            esc(error.message || error) +
            "</p>";
        }
      }

      init();
    })();
    // /MAGI
  </script>

  <style is:global>
    /* MAGI */
    .scholar-app { max-width: 820px; margin: 0 auto; padding: 40px 20px; }
    .scholar-head { margin-bottom: 32px; }
    .scholar-head h1 { font-size: 32px; margin: 12px 0 4px; }
    .scholar-head p { color: #666; font-size: 14px; margin: 0; }
    .back-link { color: #3b82f6; font-size: 14px; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .scholar-status { color: #888; font-style: italic; }
    .scholar-list { list-style: none; margin: 0; padding: 0; }
    .scholar-list li { border-bottom: 1px solid #eee; padding: 16px 0; }
    .scholar-item-title { color: #1a1a1a; font-size: 17px; text-decoration: none; }
    .scholar-item-title:hover { color: #3b82f6; }
    .scholar-meta { align-items: center; color: #888; display: flex; flex-wrap: wrap; font-size: 13px; gap: 10px; margin-top: 6px; }
    .scholar-project { background: #f3f4f6; border-radius: 4px; padding: 2px 7px; }
    .sync-note { color: #999; font-size: 12px; margin-top: 20px; }
    .scholar-article { line-height: 1.8; }
    .scholar-article > h1 { font-size: 30px; line-height: 1.35; margin: 18px 0 8px; }
    .scholar-body { margin-top: 36px; }
    .scholar-body h2 { font-size: 22px; margin: 40px 0 14px; }
    .scholar-body h3 { font-size: 19px; margin: 34px 0 12px; }
    .scholar-body h4, .scholar-body h5, .scholar-body h6 { font-size: 17px; margin: 28px 0 10px; }
    .scholar-body p { font-size: 15px; margin: 0 0 1.25em; }
    .scholar-body ul { margin: 0 0 1.25em; padding-left: 24px; }
    .scholar-body a, .scholar-source a { color: #3b82f6; overflow-wrap: anywhere; }
    .scholar-body figure { margin: 28px auto; text-align: center; }
    .scholar-body img { border-radius: 4px; height: auto; max-width: 100%; }
    .scholar-body figcaption { color: #777; font-size: 13px; margin-top: 6px; }
    .math-display { margin: 24px 0; max-width: 100%; overflow-x: auto; padding: 4px 0; }
    .citation { font-size: 0.82em; margin-left: 0.12em; vertical-align: super; }
    .citation a { text-decoration: none; }
    .scholar-bibliography { border-top: 1px solid #eee; margin-top: 42px; padding-top: 18px; }
    .scholar-bibliography h2 { font-size: 20px; }
    .scholar-bibliography li { font-size: 14px; margin-bottom: 8px; }
    .scholar-bibliography pre { background: #f7f7f7; border-radius: 4px; font-size: 11px; margin: 6px 0 14px; overflow-x: auto; padding: 10px; white-space: pre-wrap; }
    .scholar-source { border-top: 1px solid #eee; font-size: 14px; margin-top: 38px; padding-top: 16px; }
    /* /MAGI */
  </style>
  <!-- /MAGI -->
</Layout>
