---
import Layout from '../layouts/Layout.astro';
---

<Layout title="">
  <div class="profile-section">
    <div class="lang-nav">
      <button id="lang-en" class="lang-btn">En</button> / <button id="lang-ja" class="lang-btn">Ja</button>
    </div>
    <div class="export-actions" aria-label="CV export">
      <button id="export-cv-json" class="export-btn" type="button" disabled>JSON</button>
      <button id="export-cv-pdf" class="export-btn" type="button" disabled>PDF</button>
    </div>
    
    <div class="profile-main">
      <div class="profile-photo">
        <div class="photo-box">
          <img src="https://via.placeholder.com/140" alt="Profile photo" />
        </div>
      </div>
      
      <div class="profile-details">
        <h1 class="name-title">
          <span class="lang-ja" id="profile-name-ja">読み込み中…</span>
          <span class="lang-en" id="profile-name-en">Loading…</span>
        </h1>
        
        <p class="affiliation" id="profile-affiliation">読み込み中… / Loading…</p>
        
        <p class="email-text">
          fukushima.takeru.u8 [at] s.mail.nagoya-u.ac.jp
        </p>
        
        <div class="social-icons">
          <a href="https://x.com/takerufukushima" target="_blank" title="Twitter">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
          <a href="https://github.com/takeruhukushima" target="_blank" title="GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/takeru-fukushima-0078ba372/" target="_blank" title="LinkedIn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.238 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="#" target="_blank" title="Google Scholar">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 24a7 7 0 0 1-7-7c0-2.78 1.64-5.2 4.08-6.3L5.05 3.05a1 1 0 0 1 .42-1.34L12 0l6.53 1.71a1 1 0 0 1 .42 1.34L14.92 10.7c2.44 1.1 4.08 3.52 4.08 6.3a7 7 0 0 1-7 7z"/></svg>
          </a>
        </div>
      </div>
    </div>
    
    <div class="bio-text" id="profile-bio">
      <p>読み込み中… / Loading…</p>
    </div>

    <div class="section-divider"></div>

    <section id="education">
      <h2 class="lang-ja">学歴 / Education</h2>
      <h2 class="lang-en">Education</h2>
      <div class="atproto-list"><p>読み込み中… / Loading…</p></div>
    </section>

    <div class="section-divider"></div>

    <section class="presentations" id="presentations">
      <h2 class="lang-ja">学会発表 / Presentations</h2>
      <h2 class="lang-en">Presentations</h2>

      <div class="atproto-list"><p>読み込み中… / Loading…</p></div>
    </section>

    <div class="section-divider"></div>

    <section id="positions">
      <h2 class="lang-ja">職歴 / Positions</h2>
      <h2 class="lang-en">Positions</h2>
      <div class="atproto-list"><p>読み込み中… / Loading…</p></div>
    </section>

    <div class="section-divider"></div>

    <section id="open-source">
      <h2 class="lang-ja">オープンソース活動 / Open Source</h2>
      <h2 class="lang-en">Open Source</h2>
      <div class="atproto-list"><p>読み込み中… / Loading…</p></div>
    </section>

    <div id="career-extra"></div>
  </div>

  <dialog id="cv-export-dialog" class="export-dialog">
    <div class="export-dialog-head">
      <h2 id="export-preview-title">CV Preview</h2>
      <button id="close-export-preview" class="dialog-close" type="button" aria-label="閉じる">×</button>
    </div>
    <div id="export-preview" class="export-preview"></div>
    <div class="export-dialog-actions">
      <button id="cancel-export" class="export-btn" type="button">キャンセル</button>
      <button id="confirm-export" class="export-btn export-btn-primary" type="button">ダウンロード</button>
    </div>
  </dialog>

  <script is:inline>
    // 言語切り替えのロジック
    const html = document.documentElement;
    const jaBtn = document.getElementById('lang-ja');
    const enBtn = document.getElementById('lang-en');

    function setLang(lang) {
      html.setAttribute('lang', lang);
      localStorage.setItem('preferred-lang', lang);
      
      // ボタンのアクティブ状態を更新
      if (lang === 'ja') {
        jaBtn.classList.add('active');
        enBtn.classList.remove('active');
      } else {
        enBtn.classList.add('active');
        jaBtn.classList.remove('active');
      }
    }

    jaBtn.addEventListener('click', () => setLang('ja'));
    enBtn.addEventListener('click', () => setLang('en'));

    // 初期言語の設定（保存された設定があればそれを使う、なければja）
    const savedLang = localStorage.getItem('preferred-lang') || 'ja';
    setLang(savedLang);

    const DID = 'did:plc:nmhfq335cddnwt4ovrq4gzsm';
    const FALLBACK_PDS = 'https://chaga.us-west.host.bsky.network';
    const jsonButton = document.getElementById('export-cv-json');
    const pdfButton = document.getElementById('export-cv-pdf');
    const exportDialog = document.getElementById('cv-export-dialog');
    const exportPreview = document.getElementById('export-preview');
    const exportPreviewTitle = document.getElementById('export-preview-title');
    const confirmExport = document.getElementById('confirm-export');
    const closeExportPreview = document.getElementById('close-export-preview');
    const cancelExport = document.getElementById('cancel-export');
    let cvExport = null;
    let exportFormat = null;

    async function resolvePds() {
      try {
        const response = await fetch(`https://plc.directory/${DID}`);
        if (!response.ok) throw new Error(`DID resolution failed: ${response.status}`);
        const document = await response.json();
        return document.service?.find((service) =>
          service.id === '#atproto_pds' || service.type === 'AtprotoPersonalDataServer'
        )?.serviceEndpoint || FALLBACK_PDS;
      } catch {
        return FALLBACK_PDS;
      }
    }

    async function listRecords(pds, collection) {
      const records = [];
      let cursor = '';
      do {
        const query = new URLSearchParams({ repo: DID, collection, limit: '100' });
        if (cursor) query.set('cursor', cursor);
        const response = await fetch(`${pds}/xrpc/com.atproto.repo.listRecords?${query}`);
        if (!response.ok) throw new Error(`${collection}: ${response.status}`);
        const page = await response.json();
        records.push(...(page.records || []));
        cursor = page.cursor || '';
      } while (cursor);
      return records.map((record) => record.value);
    }

    const formatPeriod = (start, end) => [start, end || 'present'].filter(Boolean).join(' – ');
    const showList = (id, values, render) => {
      const host = document.querySelector(`#${id} .atproto-list`);
      host.replaceChildren();
      if (!values.length) {
        const empty = document.createElement('p');
        empty.className = 'no-publications';
        empty.textContent = 'Coming soon.';
        host.append(empty);
        return;
      }
      const list = document.createElement('ul');
      list.className = 'presentation-list';
      values.forEach((value) => list.append(render(value)));
      host.append(list);
    };
    const item = (...parts) => {
      const li = document.createElement('li');
      parts.filter(Boolean).forEach((part) => {
        if (part instanceof Node) li.append(part);
        else li.append(document.createTextNode(String(part)));
      });
      return li;
    };
    const externalLink = (label, url) => {
      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = label;
      return link;
    };

    const extraCareerCollections = [
      ['id.career.authorship', '著作・論文 / Authorship'],
      ['id.career.award', '受賞 / Awards'],
      ['id.career.grant', '研究資金 / Grants'],
      ['id.career.membership', '所属学会・団体 / Memberships'],
      ['id.career.service', '委員・査読歴 / Service'],
      ['id.career.teaching', '教育 / Teaching'],
      ['id.career.supervision', '研究指導 / Supervision'],
      ['id.career.patent', '特許 / Patents'],
      ['id.career.outreach', 'アウトリーチ / Outreach'],
      ['id.career.work', '職歴・プロジェクト / Work'],
      ['id.career.attestation', '証明・推薦 / Attestations'],
      ['id.career.dossier', 'Dossier']
    ];

    const valueText = (value) => {
      if (value == null || value === '') return '';
      if (typeof value === 'string' || typeof value === 'number') return String(value);
      if (typeof value === 'boolean') return value ? 'yes' : 'no';
      if (Array.isArray(value)) return value.map(valueText).filter(Boolean).join(', ');
      return value.name || value.literal || value.title || value.uri ||
        Object.entries(value).map(([key, child]) => `${key}: ${valueText(child)}`).join(', ');
    };

    function renderGenericRecord(record) {
      const li = document.createElement('li');
      const primaryKeys = ['title', 'name', 'role', 'courseTitle', 'patentTitle', 'activity'];
      const primaryKey = primaryKeys.find((key) => record[key]);
      const primary = primaryKey ? valueText(record[primaryKey]) : 'Record';
      const url = record.url || record.repoUrl || record.projectUrl;
      li.append(url ? externalLink(primary, url) : document.createTextNode(primary));
      const ignored = new Set(['$type', 'createdAt', 'updatedAt', primaryKey, 'url', 'repoUrl', 'projectUrl']);
      const details = Object.entries(record)
        .filter(([key, value]) => !ignored.has(key) && value != null && value !== '')
        .map(([key, value]) => `${key}: ${valueText(value)}`)
        .filter((value) => value && !value.endsWith(': '));
      if (details.length) li.append(document.createTextNode(` — ${details.join(' · ')}`));
      return li;
    }

    function renderExtraSections(results) {
      const container = document.getElementById('career-extra');
      container.replaceChildren();
      results.forEach(({ label, records }) => {
        const divider = document.createElement('div');
        divider.className = 'section-divider';
        const section = document.createElement('section');
        const heading = document.createElement('h2');
        heading.textContent = label;
        section.append(heading);
        if (records.length) {
          const list = document.createElement('ul');
          list.className = 'presentation-list';
          records.forEach((record) => list.append(renderGenericRecord(record)));
          section.append(list);
        } else {
          const empty = document.createElement('p');
          empty.className = 'no-publications';
          empty.textContent = 'Coming soon.';
          section.append(empty);
        }
        container.append(divider, section);
      });
    }

    async function loadCareer() {
      try {
        const pds = await resolvePds();
        const [profiles, education, presentations, positions, contributions] = await Promise.all([
          listRecords(pds, 'id.career.profile'),
          listRecords(pds, 'id.career.education'),
          listRecords(pds, 'id.career.presentation'),
          listRecords(pds, 'id.sifa.profile.position'),
          listRecords(pds, 'id.career.openSourceContribution')
        ]);
        const extraResults = await Promise.all(extraCareerCollections.map(async ([collection, label]) => ({
          collection,
          label,
          records: await listRecords(pds, collection)
        })));

        cvExport = {
          $schema: 'https://minori.takeruf.workers.dev/',
          did: DID,
          exportedAt: new Date().toISOString(),
          records: {
            'id.career.profile': profiles,
            'id.career.education': education,
            'id.career.presentation': presentations,
            'id.sifa.profile.position': positions,
            'id.career.openSourceContribution': contributions,
            ...Object.fromEntries(extraResults.map(({ collection, records }) => [collection, records]))
          }
        };

        const profile = profiles[0];
        if (profile) {
          document.getElementById('profile-name-ja').textContent =
            [profile.nativeName, profile.displayName].filter(Boolean).join(' / ');
          document.getElementById('profile-name-en').textContent = profile.displayName || profile.nativeName;
          const affiliation = profile.primaryAffiliation;
          document.getElementById('profile-affiliation').textContent =
            [profile.headline, affiliation?.department, affiliation?.name].filter(Boolean).join(' · ');
          const bio = document.createElement('p');
          bio.textContent = profile.bio || '';
          document.getElementById('profile-bio').replaceChildren(bio);
          const websites = document.querySelector('.social-icons');
          websites.replaceChildren();
          (profile.websites || []).forEach((website) => {
            if (!website?.url) return;
            const link = externalLink(website.label || website.url, website.url);
            link.className = 'website-link';
            link.title = website.label || website.url;
            websites.append(link);
          });
        } else {
          document.getElementById('profile-name-ja').textContent = 'Coming soon.';
          document.getElementById('profile-name-en').textContent = 'Coming soon.';
        }

        showList('education', education, (entry) => item(
          `${entry.institution?.name || ''}${entry.institution?.department ? `, ${entry.institution.department}` : ''}`,
          entry.degreeName ? ` — ${entry.degreeName}` : '',
          entry.fieldOfStudy ? ` (${entry.fieldOfStudy})` : '',
          `, ${formatPeriod(entry.startedAt, entry.endedAt)}`
        ));
        showList('presentations', presentations, (entry) => item(
          `“${entry.title},” ${entry.eventName || entry.eventSeries || ''}`,
          entry.place ? `, ${entry.place}` : '',
          entry.type ? `, ${entry.type}` : '',
          entry.date ? `, ${entry.date}` : ''
        ));
        showList('positions', positions, (entry) => item(
          entry.entityRef ? externalLink(entry.company || 'Organization', entry.entityRef) : entry.company,
          ` — ${entry.title || ''}`,
          entry.description ? `. ${entry.description}` : '',
          ` (${formatPeriod(entry.startedAt, entry.endedAt)})`
        ));
        showList('open-source', contributions, (entry) => item(
          entry.repoUrl ? externalLink(entry.name, entry.repoUrl) : entry.name,
          entry.role ? ` — ${entry.role}` : '',
          entry.description ? `. ${entry.description}` : '',
          entry.startedAt ? ` (${entry.startedAt}–)` : ''
        ));
        renderExtraSections(extraResults);
        jsonButton.disabled = false;
        pdfButton.disabled = false;
      } catch (error) {
        document.getElementById('profile-name-ja').textContent = 'プロフィールを取得できませんでした';
        document.getElementById('profile-name-en').textContent = 'Could not load profile';
        document.querySelectorAll('.atproto-list').forEach((host) => {
          const message = document.createElement('p');
          message.className = 'no-publications';
          message.textContent = 'CVを取得できませんでした。 / Could not load CV.';
          host.replaceChildren(message);
        });
        console.error(error);
      }
    }

    function downloadJson() {
      cvExport.exportedAt = new Date().toISOString();
      const blob = new Blob([`${JSON.stringify(cvExport, null, 2)}\n`], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const download = document.createElement('a');
      download.href = url;
      download.download = `cv-${new Date().toISOString().slice(0, 10)}.json`;
      download.click();
      URL.revokeObjectURL(url);
    }

    function openExportPreview(format) {
      if (!cvExport) return;
      exportFormat = format;
      exportPreview.replaceChildren();
      if (format === 'json') {
        exportPreviewTitle.textContent = 'JSON Preview';
        const code = document.createElement('pre');
        code.textContent = JSON.stringify(cvExport, null, 2);
        exportPreview.append(code);
      } else {
        exportPreviewTitle.textContent = 'PDF Preview';
        const clone = document.querySelector('.profile-section').cloneNode(true);
        clone.querySelectorAll('[id]').forEach((node) => node.removeAttribute('id'));
        clone.querySelector('.export-actions')?.remove();
        exportPreview.append(clone);
      }
      confirmExport.textContent = format === 'json' ? 'JSONをダウンロード' : 'PDFとして保存';
      exportDialog.showModal();
    }

    const closeDialog = () => exportDialog.close();
    jsonButton.addEventListener('click', () => openExportPreview('json'));
    pdfButton.addEventListener('click', () => openExportPreview('pdf'));
    closeExportPreview.addEventListener('click', closeDialog);
    cancelExport.addEventListener('click', closeDialog);
    exportDialog.addEventListener('click', (event) => {
      if (event.target === exportDialog) closeDialog();
    });
    confirmExport.addEventListener('click', () => {
      exportDialog.close();
      if (exportFormat === 'json') downloadJson();
      if (exportFormat === 'pdf') window.print();
    });

    loadCareer();
  </script>
</Layout>

<style>
  .profile-section {
    position: relative;
    margin-bottom: 60px;
  }

  .lang-nav {
    position: absolute;
    top: 0;
    right: 0;
    font-size: 13px;
    color: #666;
    letter-spacing: 0.05em;
  }

  .export-actions {
    position: absolute;
    top: 28px;
    right: 0;
    display: flex;
    gap: 7px;
  }

  .export-btn {
    border: 1px solid #b9c7d5;
    border-radius: 4px;
    background: #fff;
    color: #326b9f;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    padding: 4px 9px;
  }

  .export-btn:hover:not(:disabled) { background: #f1f6fb; }
  .export-btn:disabled { cursor: wait; opacity: .45; }

  .export-btn-primary { background: #326b9f; color: #fff; }
  .export-btn-primary:hover:not(:disabled) { background: #28577f; }

  .export-dialog {
    width: min(900px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    border: 0;
    border-radius: 8px;
    box-shadow: 0 18px 60px rgba(0, 0, 0, .25);
    padding: 0;
  }

  .export-dialog::backdrop { background: rgba(20, 28, 36, .55); }
  .export-dialog-head, .export-dialog-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: #fff;
  }
  .export-dialog-head { position: sticky; top: 0; z-index: 1; border-bottom: 1px solid #ddd; }
  .export-dialog-head h2 { margin: 0; font-size: 18px; }
  .export-dialog-actions { position: sticky; bottom: 0; justify-content: flex-end; border-top: 1px solid #ddd; }
  .dialog-close { border: 0; background: none; cursor: pointer; font-size: 26px; line-height: 1; }
  .export-preview { padding: 24px; overflow: auto; background: #f5f6f7; }
  .export-preview pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12px; }
  .export-preview :global(.profile-section) { margin: 0; padding: 28px; background: #fff; box-shadow: 0 1px 5px rgba(0,0,0,.08); }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: inherit;
    font-family: inherit;
    color: #888;
    transition: color 0.2s;
  }

  .lang-btn.active {
    color: #333;
    font-weight: bold;
  }

  .lang-btn:hover {
    color: #000;
  }

  .profile-main {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    margin-top: 40px;
    margin-bottom: 40px;
  }

  .profile-photo {
    flex-shrink: 0;
  }

  .photo-box {
    width: 140px;
    height: 140px;
    overflow: hidden;
    border-radius: 4px;
  }

  .photo-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-details {
    flex: 1;
  }

  .name-title {
    font-size: 32px;
    margin: 0 0 12px 0;
    font-weight: bold;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .affiliation {
    font-size: 16px;
    margin: 0 0 8px 0;
    color: #333;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .email-text {
    font-size: 14px;
    margin: 0 0 16px 0;
    color: #555;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }

  .social-icons a {
    color: #4a7fb4;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .social-icons a:hover {
    color: #333;
  }

  .social-icons .website-link {
    border: 1px solid #c9d7e4 !important;
    border-radius: 999px;
    font-size: 12px;
    padding: 3px 9px;
  }

  .bio-text {
    margin-bottom: 40px;
    max-width: 800px;
  }

  .section-divider {
    height: 1px;
    background-color: #eee;
    margin: 40px 0;
  }

  .pub-links {
    font-size: 14px;
    margin-bottom: 24px;
    color: #666;
  }

  .no-publications {
    color: #888;
    font-style: italic;
  }

  .presentation-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .presentation-list li {
