---
import Layout from '../layouts/Layout.astro';
---

<Layout title="">
  <div class="profile-section">
    <div class="export-actions" aria-label="CV export">
      <span class="language-switch" aria-label="表示言語 / Language">
        <a class="export-btn" href="/?lang=ja" data-locale="ja">日本語</a>
        <a class="export-btn" href="/?lang=en" data-locale="en">English</a>
      </span>
      <a class="export-btn" href="/cv.json">JSON</a>
      <a class="export-btn export-btn-primary" href="/cv-ja.pdf">PDF (JA)</a>
      <a class="export-btn" href="/cv-en.pdf">PDF (EN)</a>
    </div>
    
    <div class="profile-main">
      <div class="profile-photo">
        <a
          class="photo-box"
          id="bsky-profile-link"
          href="https://bsky.app/profile/did:plc:nmhfq335cddnwt4ovrq4gzsm"
          target="_blank"
          rel="noopener"
          aria-label="Bluesky profile"
        >
          <img id="profile-avatar" alt="" hidden />
        </a>
      </div>

      <div class="profile-details">
        <h1 class="name-title" id="profile-name">読み込み中…</h1>
        
        <p class="affiliation" id="profile-affiliation">読み込み中…</p>
        
        <p class="email-text">
          fukushima.takeru.u8 [at] s.mail.nagoya-u.ac.jp
        </p>
        
        <div class="social-icons"></div>
      </div>
    </div>
    
    <div class="bio-text" id="profile-bio">
      <p>読み込み中…</p>
    </div>

    <div class="section-divider"></div>

    <section id="education">
      <h2 data-heading="education">学歴</h2>
      <div class="atproto-list"><p>読み込み中…</p></div>
    </section>

    <div class="section-divider"></div>

    <section class="presentations" id="presentations">
      <h2 data-heading="presentations">学会発表</h2>

      <div class="atproto-list"><p>読み込み中…</p></div>
    </section>

    <div class="section-divider"></div>

    <section id="positions">
      <h2 data-heading="positions">職歴</h2>
      <div class="atproto-list"><p>読み込み中…</p></div>
    </section>

    <div class="section-divider"></div>

    <section id="open-source">
      <h2 data-heading="openSource">オープンソース活動</h2>
      <div class="atproto-list"><p>読み込み中…</p></div>
    </section>

    <div id="career-extra"></div>
  </div>

  <script is:inline>
    const DID = 'did:plc:nmhfq335cddnwt4ovrq4gzsm';
    const FALLBACK_PDS = 'https://chaga.us-west.host.bsky.network';
    const locale = new URLSearchParams(window.location.search).get('lang') === 'en' ? 'en' : 'ja';
    const copy = {
      ja: {
        title: '福島武', loading: '読み込み中…', present: '現在', soon: '準備中です。',
        education: '学歴', presentations: '学会発表', positions: '職歴', openSource: 'オープンソース活動',
        unavailable: 'プロフィールを取得できませんでした', cvUnavailable: 'CVを取得できませんでした。',
        organization: '組織', nav: ['ホーム', '論文', '連絡先', 'ブログ'], navLabel: 'メインナビゲーション',
        extras: ['著作・論文', '受賞', '研究資金', '所属学会・団体', '委員・査読歴', '教育',
          '研究指導', '特許', 'アウトリーチ', '職歴・プロジェクト', '証明・推薦', 'Dossier']
      },
      en: {
        title: 'Takeru Fukushima', loading: 'Loading…', present: 'Present', soon: 'Coming soon.',
        education: 'Education', presentations: 'Presentations', positions: 'Experience', openSource: 'Open Source',
        unavailable: 'Could not load profile', cvUnavailable: 'Could not load CV.', organization: 'Organization',
        nav: ['Home', 'Publications', 'Contact', 'Blog'], navLabel: 'Main navigation',
        extras: ['Authorship', 'Awards', 'Grants', 'Memberships', 'Service', 'Teaching',
          'Supervision', 'Patents', 'Outreach', 'Work and projects', 'Attestations', 'Dossier']
      }
    };
    const ui = copy[locale];

    document.documentElement.lang = locale;
    document.title = ui.title;
    document.querySelector(`[data-locale="${locale}"]`)?.setAttribute('aria-current', 'page');
    document.querySelectorAll('[data-heading]').forEach((heading) => {
      heading.textContent = ui[heading.dataset.heading];
    });
    document.querySelectorAll('.atproto-list > p, #profile-bio > p').forEach((item) => {
      item.textContent = ui.loading;
    });
    const navigation = document.querySelector('.nav-menu');
    navigation?.setAttribute('aria-label', ui.navLabel);
    navigation?.querySelectorAll('a').forEach((link, index) => { link.textContent = ui.nav[index]; });

    async function resolvePds() {
      try {
        const response = await fetch(`https://plc.directory/${DID}`);
        if (!response.ok) throw new Error(`DID resolution failed: ${response.status}`);
        const document = await response.json();
        return document.service?.find((service) =>
          service.id === '#atproto_pds' || service.type === 'AtprotoPersonalDataServer'
        )?.serviceEndpoint || FALLBACK_PDS;
      } catch {
        return FALLBACK_PDS;
      }
    }

    async function loadBskyProfile() {
      try {
        const query = new URLSearchParams({ actor: DID });
        const response = await fetch(`https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile?${query}`);
        if (!response.ok) throw new Error(`Bluesky profile: ${response.status}`);
        const profile = await response.json();
        const link = document.getElementById('bsky-profile-link');
        const avatar = document.getElementById('profile-avatar');
        link.href = `https://bsky.app/profile/${profile.handle || DID}`;
        if (profile.avatar) {
          avatar.src = profile.avatar;
          avatar.alt = `${profile.displayName || profile.handle || 'Bluesky'} profile photo`;
          avatar.hidden = false;
        }
      } catch (error) {
        console.error('Could not load Bluesky profile.', error);
      }
    }

    async function listRecords(pds, collection) {
      const records = [];
      let cursor = '';
      do {
        const query = new URLSearchParams({ repo: DID, collection, limit: '100' });
        if (cursor) query.set('cursor', cursor);
        const response = await fetch(`${pds}/xrpc/com.atproto.repo.listRecords?${query}`);
        if (!response.ok) throw new Error(`${collection}: ${response.status}`);
        const page = await response.json();
        records.push(...(page.records || []));
        cursor = page.cursor || '';
      } while (cursor);
      return records.map((record) => record.value);
    }

    const formatPeriod = (start, end) => [start, end || ui.present].filter(Boolean).join(' – ');
    const localizedText = (value, selectedLocale = locale) => {
      if (value == null || value === '') return '';
      if (typeof value === 'string' || typeof value === 'number') return String(value);
      if (!Array.isArray(value)) return '';

      const localizedValues = value.filter((item) =>
        item && typeof item === 'object' &&
        typeof item.language === 'string' && typeof item.value === 'string'
      );
      if (localizedValues.length) {
        return localizedValues.find((item) => item.language === selectedLocale)?.value
          || localizedValues.find((item) => item.language === 'en')?.value
          || localizedValues[0].value;
      }

      return value.map((item) => localizedText(item, selectedLocale)).filter(Boolean).join(', ');
    };
    const showList = (id, values, render) => {
      const host = document.querySelector(`#${id} .atproto-list`);
      host.replaceChildren();
      if (!values.length) {
        const empty = document.createElement('p');
        empty.className = 'no-publications';
        empty.textContent = ui.soon;
        host.append(empty);
        return;
      }
      const list = document.createElement('ul');
      list.className = 'presentation-list';
      values.forEach((value) => list.append(render(value)));
      host.append(list);
    };
    const item = (...parts) => {
      const li = document.createElement('li');
      parts.filter(Boolean).forEach((part) => {
        if (part instanceof Node) li.append(part);
        else li.append(document.createTextNode(String(part)));
      });
      return li;
    };
    const externalLink = (label, url) => {
      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = label;
      return link;
    };

    const extraCareerCollections = [
      'id.career.authorship', 'id.career.award', 'id.career.grant', 'id.career.membership',
      'id.career.service', 'id.career.teaching', 'id.career.supervision', 'id.career.patent',
      'id.career.outreach', 'id.career.work', 'id.career.attestation', 'id.career.dossier'
    ].map((collection, index) => [collection, ui.extras[index]]);

    const valueText = (value) => {
      if (value == null || value === '') return '';
      if (typeof value === 'string' || typeof value === 'number') return String(value);
      if (typeof value === 'boolean') return value ? 'yes' : 'no';
      if (Array.isArray(value) && value.some((item) => item?.language && item?.value)) {
        return localizedText(value);
      }
      if (Array.isArray(value)) return value.map(valueText).filter(Boolean).join(', ');
      if (value.variants) return localizedText(value.variants);
      return localizedText(value.name) || value.literal || localizedText(value.title) || value.uri ||
        Object.entries(value).map(([key, child]) => `${key}: ${valueText(child)}`).join(', ');
    };

    function renderGenericRecord(record) {
      const li = document.createElement('li');
      const primaryKeys = ['title', 'name', 'role', 'courseTitle', 'patentTitle', 'activity'];
      const primaryKey = primaryKeys.find((key) => record[key]);
      const primary = primaryKey ? valueText(record[primaryKey]) : 'Record';
      const url = record.url || record.repoUrl || record.projectUrl;
      li.append(url ? externalLink(primary, url) : document.createTextNode(primary));
      const ignored = new Set(['$type', 'createdAt', 'updatedAt', primaryKey, 'url', 'repoUrl', 'projectUrl']);
      const details = Object.entries(record)
        .filter(([key, value]) => !ignored.has(key) && value != null && value !== '')
        .map(([key, value]) => `${key}: ${valueText(value)}`)
        .filter((value) => value && !value.endsWith(': '));
      if (details.length) li.append(document.createTextNode(` — ${details.join(' · ')}`));
      return li;
    }

    function renderExtraSections(results) {
      const container = document.getElementById('career-extra');
      container.replaceChildren();
      results.forEach(({ collection, label, records }) => {
        const divider = document.createElement('div');
        divider.className = 'section-divider';
        const section = document.createElement('section');
        if (collection === 'id.career.authorship') section.id = 'publications';
        const heading = document.createElement('h2');
        heading.textContent = label;
        section.append(heading);
        if (records.length) {
          const list = document.createElement('ul');
          list.className = 'presentation-list';
          records.forEach((record) => list.append(renderGenericRecord(record)));
          section.append(list);
        } else {
          const empty = document.createElement('p');
          empty.className = 'no-publications';
          empty.textContent = ui.soon;
          section.append(empty);
        }
        container.append(divider, section);
      });

      if (window.location.hash === '#publications') {
        requestAnimationFrame(() => document.getElementById('publications')?.scrollIntoView());
      }
    }

    async function loadCareer() {
      try {
        const pds = await resolvePds();
        const [profiles, education, presentations, positions, contributions] = await Promise.all([
          listRecords(pds, 'id.career.profile'),
          listRecords(pds, 'id.career.education'),
          listRecords(pds, 'id.career.presentation'),
          listRecords(pds, 'id.sifa.profile.position'),
          listRecords(pds, 'id.career.openSourceContribution')
        ]);
        const extraResults = await Promise.all(extraCareerCollections.map(async ([collection, label]) => ({
          collection,
          label,
          records: await listRecords(pds, collection)
        })));

        const profile = profiles[0];
        if (profile) {
          document.getElementById('profile-name').textContent =
            localizedText(profile.nativeName) || localizedText(profile.displayName);
          const affiliation = profile.primaryAffiliation;
          document.getElementById('profile-affiliation').textContent =
            [localizedText(profile.headline), localizedText(affiliation?.department), localizedText(affiliation?.name)]
              .filter(Boolean).join(' · ');
          const bio = document.createElement('p');
          bio.textContent = localizedText(profile.bio);
          document.getElementById('profile-bio').replaceChildren(bio);
          const websites = document.querySelector('.social-icons');
          websites.replaceChildren();
          (profile.websites || []).forEach((website) => {
            if (!website?.url) return;
            const label = localizedText(website.label) || website.url;
            const link = externalLink(label, website.url);
            link.className = 'website-link';
            link.title = label;
            websites.append(link);
          });
        } else {
          document.getElementById('profile-name').textContent = ui.soon;
        }

        showList('education', education, (entry) => item(
          `${localizedText(entry.institution?.name)}${localizedText(entry.institution?.department) ? `, ${localizedText(entry.institution.department)}` : ''}`,
          localizedText(entry.degreeName) ? ` — ${localizedText(entry.degreeName)}` : '',
          localizedText(entry.fieldOfStudy) ? ` (${localizedText(entry.fieldOfStudy)})` : '',
          `, ${formatPeriod(entry.startedAt, entry.endedAt)}`
        ));
        showList('presentations', presentations, (entry) => item(
          `“${localizedText(entry.title)},” ${localizedText(entry.eventName) || localizedText(entry.eventSeries)}`,
          localizedText(entry.place) ? `, ${localizedText(entry.place)}` : '',
          entry.type ? `, ${entry.type}` : '',
          entry.date ? `, ${entry.date}` : ''
        ));
        showList('positions', positions, (entry) => item(
          entry.entityRef ? externalLink(entry.company || ui.organization, entry.entityRef) : entry.company,
          ` — ${entry.title || ''}`,
          entry.description ? `. ${entry.description}` : '',
          ` (${formatPeriod(entry.startedAt, entry.endedAt)})`
        ));
        showList('open-source', contributions, (entry) => item(
          entry.repoUrl ? externalLink(localizedText(entry.name), entry.repoUrl) : localizedText(entry.name),
          entry.role ? ` — ${entry.role}` : '',
          localizedText(entry.description) ? `. ${localizedText(entry.description)}` : '',
          entry.startedAt ? ` (${entry.startedAt}–)` : ''
        ));
        renderExtraSections(extraResults);
      } catch (error) {
        document.getElementById('profile-name').textContent = ui.unavailable;
        document.querySelectorAll('.atproto-list').forEach((host) => {
          const message = document.createElement('p');
          message.className = 'no-publications';
          message.textContent = ui.cvUnavailable;
          host.replaceChildren(message);
        });
        console.error(error);
      }
    }

    loadBskyProfile();
    loadCareer();
  </script>
</Layout>

<style>
  .profile-section {
    position: relative;
    margin-bottom: 60px;
  }

  .export-actions {
    position: absolute;
    top: 28px;
    right: 0;
    display: flex;
    gap: 7px;
  }

  .language-switch {
    display: inline-flex;
  }

  .language-switch .export-btn {
    border-radius: 0;
  }

  .language-switch .export-btn:first-child {
    border-radius: 4px 0 0 4px;
  }

  .language-switch .export-btn:last-child {
    margin-left: -1px;
    border-radius: 0 4px 4px 0;
  }

  .language-switch .export-btn[aria-current="page"] {
    position: relative;
    border-color: #326b9f;
    background: #e5f0f8;
    color: #234f75;
    font-weight: 700;
  }

  .export-btn {
    display: inline-block;
    border: 1px solid #b9c7d5;
    border-radius: 4px;
    background: #fff;
    color: #326b9f;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    padding: 4px 9px;
    text-decoration: none !important;
  }

  .export-btn:hover:not(:disabled) { background: #f1f6fb; }
  .export-btn-primary { background: #326b9f; color: #fff; }
  .export-btn-primary:hover:not(:disabled) { background: #28577f; }

  .profile-main {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    margin-top: 40px;
    margin-bottom: 40px;
  }

  .profile-photo {
    flex-shrink: 0;
  }

  .photo-box {
    display: block;
    width: 140px;
    height: 140px;
    overflow: hidden;
    border-radius: 4px;
    border-bottom: 0 !important;
  }

  .photo-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-details {
    flex: 1;
  }

  .name-title {
    font-size: 32px;
    margin: 0 0 12px 0;
    font-weight: bold;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .affiliation {
    font-size: 16px;
    margin: 0 0 8px 0;
    color: #333;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .email-text {
    font-size: 14px;
    margin: 0 0 16px 0;
    color: #555;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }

  .social-icons a {
    color: #4a7fb4;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .social-icons a:hover {
    color: #333;
  }

  .social-icons .website-link {
    border: 1px solid #c9d7e4 !important;
    border-radius: 999px;
    font-size: 12px;
    padding: 3px 9px;
  }

  .bio-text {
    margin-bottom: 40px;
    max-width: 800px;
  }

  .section-divider {
    height: 1px;
    background-color: #eee;
    margin: 40px 0;
  }

  .pub-links {
    font-size: 14px;
    margin-bottom: 24px;
    color: #666;
  }

  .no-publications {
    color: #888;
    font-style: italic;
  }

  .presentation-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .presentation-list li {
    margin-bottom: 16px;
    font-size: 14px;
    line-height: 1.7;
    color: #333;
  }

  @media (max-width: 640px) {
    .profile-main {
      flex-direction: column;
      gap: 24px;
      align-items: center;
      text-align: center;
    }
    .social-icons {
      justify-content: center;
    }
    .export-actions {
      position: static;
      justify-content: flex-end;
      margin: -12px 0 16px;
    }
  }

  @media print {
    .export-actions, .social-icons { display: none !important; }
    .profile-section { margin: 0; }
    .profile-main { margin-top: 0; }
    .section-divider { margin: 22px 0; }
    section { break-inside: avoid; }
    a { color: inherit !important; text-decoration: none !important; }
  }
</style>
